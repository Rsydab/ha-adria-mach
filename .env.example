# Kopiera den här filen till ".env" i samma mapp och fyll i dina uppgifter.
# .env innehåller ditt lösenord – dela den aldrig och lägg den inte i något repo.
MACH_USERNAME=din-mach-epost@example.com
MACH_PASSWORD=ditt-mach-lösenord
# Din MACH-enhets id, 12 tecken (syns i appen som "Upprättar en LTE anslutning till ...")
MACH_ID=XXXXXXXXXXXX
